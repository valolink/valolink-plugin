# SSH connection for the dev WordPress server
DEV_SSH_HOST=user@devserver.example.com
# DEV_SSH_PORT=22
# DEV_SSH_KEY=~/.ssh/id_ed25519

# Absolute path to the WordPress installation root on the dev server.
# The plugin will be synced to $DEV_WP_PATH/wp-content/plugins/valolink-plugin
DEV_WP_PATH=/var/www/html

# Linux user (and group) that should own the synced files on the server.
# Useful when connecting as root but files should be owned by e.g. www-data.
# DEV_LINUX_USER=www-data

# Set to true to mirror local deletions to the server (rsync --delete).
# DEV_RSYNC_DELETE=false
